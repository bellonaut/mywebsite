---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import fs from "node:fs";
import path from "node:path";

const galleryDir = new URL("../../public/gallery/", import.meta.url);
const allowedExt = new Set([".jpg", ".jpeg", ".png", ".svg", ".webp"]);

const humanAlt = (name: string) => {
  const base = path.parse(name).name.replace(/[-_]+/g, " ");
  const first = base.charAt(0).toUpperCase() + base.slice(1);
  return base.toLowerCase().includes("portrait")
    ? "Pixel portrait of Bashir Bello"
    : first || "Bashir Bello";
};

let galleryData: { src: string; alt: string }[] = [];
try {
  const files = fs
    .readdirSync(galleryDir, { withFileTypes: true })
    .filter((d) => d.isFile())
    .map((d) => d.name)
    .filter((name) => allowedExt.has(path.extname(name).toLowerCase()));

  // Explicit ordering: portrait → speech → conference2 → nigeria → watershot, then the rest
  const priority = ["portrait.svg", "speech.png", "conference2.png", "nigeria.jpeg", "watershot.jpeg"];
  const ordered = [
    ...priority.filter((p) => files.includes(p)),
    ...files
      .filter((f) => !priority.includes(f))
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" })),
  ];

  galleryData = ordered.map((name) => ({
    src: `/gallery/${name}`,
    alt: humanAlt(name),
  }));
} catch (err) {
  console.warn("Hero gallery: unable to read public/gallery", err);
  galleryData = [
    { src: "/gallery/portrait.svg", alt: "Pixel portrait of Bashir Bello" },
  ];
}
---

<Card
  colSpan="md:col-span-3"
  rowSpan="md:row-span-4"
  height="h-auto md:h-full"
  overflow="overflow-visible md:overflow-hidden"
>
  <div class="hero-shell flex w-full h-full relative overflow-hidden">

    <div
      class="hero-layout relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 md:gap-10 w-full h-full"
    >
      <div class="hero-content flex-1 space-y-4 order-1">
        <h1 class="m-0 font-bold text-3xl md:text-4xl leading-tight">
          Hi, I’m Bashir Aminu Bello.
        </h1>
        <p class="m-0 text-base md:text-lg text-white/85 max-w-2xl">
          healthcare data scientist & community agent.
        </p>
        <div class="hero-actions">
          <div class="hero-actions-grid">
            <div class="hero-actions-left">
              <div class="hero-cta-row">
                <a class="hero-cta hero-cta-shimmer" href="/projects">
                  <span class="hero-cta-label">View all projects</span>
                  <span class="hero-cta-shine" aria-hidden="true"></span>
                  <span class="hero-cta-arrow">↗</span>
                </a>
                <a class="hero-cta ghost" href={LINKS.substack} target="_blank" rel="noopener noreferrer">
                  Latest articles ↗
                </a>
              </div>

              <div class="hero-interests" aria-label="Interests">
                <span class="interest" data-interest="running">🏃 Running</span>
                <span class="interest" data-interest="chelsea">💙 Chelsea FC</span>
                <span class="interest" data-interest="overwatch">
                  <img
                    class="interest-icon"
                    src="/icons/overwatch.png"
                    alt="Overwatch"
                    loading="lazy"
                    decoding="async"
                  />
                  Overwatch
                </span>
                <span class="interest" data-interest="terraria">
                  <img
                    class="interest-icon"
                    src="/icons/terraria_logo.png"
                    alt="Terraria"
                    loading="lazy"
                    decoding="async"
                  />
                  Terraria
                </span>
                <a
                  class="interest interest-link-button"
                  href="https://www.goodreads.com/review/list/159707285?ref=nav_mybooks"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Fantasy books reading list on Goodreads"
                >
                  📚 Fantasy books
                </a>
              </div>
            </div>

            <div class="hero-logos" aria-label="Languages, frameworks, and tools">
              <img src="https://cdn.simpleicons.org/python/ffffff" alt="Python" />
              <img src="https://cdn.simpleicons.org/r/ffffff" alt="R" />
              <img src="https://cdn.simpleicons.org/typescript/ffffff" alt="TypeScript" />
              <img src="https://cdn.simpleicons.org/javascript/ffffff" alt="JavaScript" />
              <img src="https://cdn.simpleicons.org/astro/ffffff" alt="Astro" />
              <img src="https://cdn.simpleicons.org/react/ffffff" alt="React" />
              <img src="https://cdn.simpleicons.org/svelte/ffffff" alt="Svelte" />
              <img src="https://cdn.simpleicons.org/tailwindcss/ffffff" alt="Tailwind CSS" />
              <img src="https://cdn.simpleicons.org/docker/ffffff" alt="Docker" />
              <img src="https://cdn.simpleicons.org/postgresql/ffffff" alt="PostgreSQL" />
              <img src="https://cdn.simpleicons.org/github/ffffff" alt="GitHub" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="hero-portrait flex-shrink-0 order-2 md:order-none w-full md:w-auto flex justify-center md:justify-end"
    >
      <div class="hero-gallery-wrap">
        <div class="hero-gallery" data-hero-gallery>
        <img
          data-gallery-img="a"
          class="gallery-img is-active"
          src="/gallery/portrait.svg"
          alt="Pixel portrait of Bashir Aminu Bello"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <img
          data-gallery-img="b"
          class="gallery-img"
          alt=""
          decoding="async"
          loading="lazy"
        />

        <div class="hero-gallery-controls">
          <button
            type="button"
            class="hero-gallery-arrow prev"
            data-gallery-prev
            aria-label="Previous photo"
          >
            <svg viewBox="0 0 20 20" role="presentation">
              <path
                d="M12.5 4.5 7 10l5.5 5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            class="hero-gallery-arrow next"
            data-gallery-next
            aria-label="Next photo"
          >
            <svg viewBox="0 0 20 20" role="presentation">
              <path
                d="M7.5 4.5 13 10l-5.5 5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
        </div>
      </div>
      <script
        type="application/json"
        id="hero-gallery-data"
        set:html={JSON.stringify(galleryData)}
      ></script>
    </div>
  </div>
</Card>
<script is:inline>
  (() => {
    // Light interaction only: keep the Overwatch burst, remove tooltips for clubs/running.
    const interests = document.querySelectorAll(".hero-interests .interest");
    if (interests.length) {
      const burstStars = (el) => {
        const rect = el.getBoundingClientRect();
        const originX = rect.left + window.scrollX + rect.width / 2;
        const originY = rect.top + window.scrollY + rect.height / 2;

        for (let i = 0; i < 9; i++) {
          const s = document.createElement("span");
          s.className = "ow-star";
          const dx = (Math.random() - 0.5) * 120;
          const dy = -40 - Math.random() * 80;
          const rot = (Math.random() - 0.5) * 120;
          s.style.setProperty("--dx", `${dx}px`);
          s.style.setProperty("--dy", `${dy}px`);
          s.style.setProperty("--rot", `${rot}deg`);
          s.style.left = `${originX}px`;
          s.style.top = `${originY}px`;
          document.body.appendChild(s);
          setTimeout(() => s.remove(), 650);
        }
      };

      interests.forEach((item) => {
        const key = item.getAttribute("data-interest");
        if (!key) return;
        if (key === "overwatch") {
          item.addEventListener("click", () => burstStars(item));
        }
      });
    }

    // Hero micro-gallery with crossfade + arrows
    const dataEl = document.getElementById("hero-gallery-data");
    let galleryItems = [];
    try {
      galleryItems = JSON.parse(dataEl?.textContent || "[]");
    } catch (e) {
      console.warn("Hero gallery: JSON parse failed", e);
    }
    if (!Array.isArray(galleryItems) || !galleryItems.length) {
      galleryItems = [{ src: "/gallery/portrait.svg", alt: "Pixel portrait of Bashir Bello" }];
    }

    const galleryRoot = document.querySelector("[data-hero-gallery]");
    if (!galleryRoot || !galleryItems.length) return;

    const imgA = galleryRoot.querySelector("[data-gallery-img='a']");
    const imgB = galleryRoot.querySelector("[data-gallery-img='b']");
    const prevBtn = galleryRoot.querySelector("[data-gallery-prev]");
    const nextBtn = galleryRoot.querySelector("[data-gallery-next]");
    const prefersReduce =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let activeSlot = imgA;
    let idleSlot = imgB;
    let current = 0;
    let timer = null;

    let lastWidth = null;

    const setRatio = (ratio) => {
      if (!galleryRoot) return;
      if (!ratio || Number.isNaN(ratio)) return;
      const prevWidth = galleryRoot.getBoundingClientRect().width;
      const clamped = Math.max(0.55, Math.min(ratio, 1.9));
      galleryRoot.style.setProperty("--gallery-ratio", clamped.toFixed(4));

      // Keep the gallery visually anchored at its center when width changes
      requestAnimationFrame(() => {
        const nextWidth = galleryRoot.getBoundingClientRect().width;
        if (lastWidth === null) lastWidth = prevWidth;
        const shift = ((prevWidth ?? nextWidth) - nextWidth) / 2;
        galleryRoot.style.setProperty("--gallery-shift", `${shift}px`);
        lastWidth = nextWidth;
      });
    };

    const measure = (img) => {
      if (!img) return;
      const apply = () => {
        if (img.naturalWidth && img.naturalHeight) {
          setRatio(img.naturalWidth / img.naturalHeight);
        }
      };
      if (img.complete && img.naturalWidth) {
        apply();
      } else {
        img.addEventListener("load", apply, { once: true });
      }
    };

    const setSlot = (slot, item, highPriority = false) => {
      if (!slot || !item) return;
      slot.src = item.src;
      slot.alt = item.alt || "Bashir Bello";
      if (highPriority) {
        slot.setAttribute("fetchpriority", "high");
      } else {
        slot.removeAttribute("fetchpriority");
      }
    };

    setSlot(activeSlot, galleryItems[0], true);
    if (galleryItems[1]) setSlot(idleSlot, galleryItems[1]);
    measure(activeSlot);

    const preload = (index) => {
      const item = galleryItems[index];
      if (!item) return;
      const img = new Image();
      img.decoding = "async";
      img.src = item.src;
    };
    preload(1);

    const swapTo = (index) => {
      if (!idleSlot || !activeSlot) return;
      if (index === current || !galleryItems[index]) return;

      const nextItem = galleryItems[index];
      setSlot(idleSlot, nextItem);

      idleSlot.classList.add("is-active");
      activeSlot.classList.remove("is-active");

      [activeSlot, idleSlot] = [idleSlot, activeSlot];
      current = index;

      preload((index + 1) % galleryItems.length);
      measure(activeSlot);
    };

    const next = () => swapTo((current + 1) % galleryItems.length);
    const prev = () => swapTo((current - 1 + galleryItems.length) % galleryItems.length);

    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      if (galleryItems.length < 2 || prefersReduce) return;
      stop();
      timer = setInterval(next, 6800);
    };

    prevBtn?.addEventListener("click", () => {
      prev();
      start();
    });
    nextBtn?.addEventListener("click", () => {
      next();
      start();
    });

    galleryRoot.addEventListener("mouseenter", stop);
    galleryRoot.addEventListener("mouseleave", start);
    prevBtn?.addEventListener("focus", stop);
    nextBtn?.addEventListener("focus", stop);
    prevBtn?.addEventListener("blur", start);
    nextBtn?.addEventListener("blur", start);

    if (galleryItems.length < 2) {
      galleryRoot.classList.add("gallery-single");
      if (prevBtn?.parentElement) prevBtn.parentElement.style.display = "none";
    }

    start();
  })();
</script>
<style>
  .hero-card {
    position: relative;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-actions-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .hero-actions-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(120, 190, 255, 0.35);
    background: rgba(10, 30, 60, 0.45);
    color: rgba(235, 245, 255, 0.95);
    font-size: 0.9rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .hero-cta:hover {
    border-color: rgba(56, 189, 248, 0.65);
    transform: translateY(-1px);
  }

  .hero-cta-shimmer {
    position: relative;
    overflow: hidden;
  }

  .hero-cta-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent,
      rgba(200, 240, 255, 0.45),
      transparent
    );
    transform: translateX(-120%);
    animation: heroCtaShine 3.4s ease-in-out infinite;
    opacity: 0.8;
  }

  .hero-cta-label,
  .hero-cta-arrow {
    position: relative;
    z-index: 1;
  }

  @keyframes heroCtaShine {
    0% { transform: translateX(-120%); opacity: 0; }
    12% { opacity: 0.9; }
    48% { transform: translateX(120%); opacity: 0.9; }
    100% { transform: translateX(120%); opacity: 0; }
  }

  .hero-cta.ghost {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-cta.ghost:hover {
    border-color: rgba(180, 225, 255, 0.75);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta-shine {
      animation: none;
      opacity: 0.25;
      transform: none;
    }
  }

  .hero-logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    justify-items: center;
    align-content: start;
    justify-self: center;
    max-width: 260px;
  }

  .hero-logos img {
    width: 18px;
    height: 18px;
    opacity: 0.6;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.25));
  }

  .hero-gallery-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-gallery {
    --gallery-height: clamp(210px, 26vw, 280px);
    --gallery-min-w: 190px;
    --gallery-max-w: 420px;
    --gallery-ratio: 0.75;
    --gallery-shift: 0px;
    position: relative;
    width: clamp(
      var(--gallery-min-w),
      calc(var(--gallery-height) * var(--gallery-ratio)),
      var(--gallery-max-w)
    );
    height: var(--gallery-height);
    transform: translateX(var(--gallery-shift));
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.38);
    background: radial-gradient(
        circle at 30% 30%,
        rgba(80, 140, 255, 0.18),
        rgba(6, 12, 22, 0.85)
      ),
      linear-gradient(180deg, rgba(12, 28, 52, 0.55), rgba(6, 10, 18, 0.9));
    border: 1px solid rgba(120, 190, 255, 0.24);
    transition: width 0.45s ease 0.08s, height 0.45s ease 0.08s, transform 0.45s ease 0.08s;
    transform-origin: center center;
  }

  .gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.55s ease;
    user-select: none;
  }

  .gallery-img.is-active {
    opacity: 1;
  }

  .hero-gallery-controls {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    pointer-events: none;
  }

  .hero-gallery-arrow {
    pointer-events: auto;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(120, 190, 255, 0.35);
    background: rgba(8, 16, 28, 0.65);
    color: rgba(220, 240, 255, 0.92);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    backdrop-filter: blur(8px);
  }

  .hero-gallery-arrow:hover,
  .hero-gallery-arrow:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(160, 210, 255, 0.75);
    outline: none;
    background: rgba(12, 26, 44, 0.9);
  }

  .hero-gallery-arrow svg {
    width: 16px;
    height: 16px;
  }

  .hero-gallery.gallery-single .hero-gallery-controls {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-img {
      transition: none;
    }
  }

  .hero-interests {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .interest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: rgba(230, 245, 255, 0.85);
    border: 1px solid rgba(120, 190, 255, 0.18);
    background: rgba(10, 20, 35, 0.35);
  }

  .interest-link-button {
    text-decoration: none;
  }

  .interest-link-button:hover {
    border-color: rgba(56, 189, 248, 0.5);
  }

  .interest-link-button:focus-visible {
    outline: 2px solid rgba(120, 200, 255, 0.6);
    outline-offset: 2px;
  }

  .interest-icon {
    width: 16px;
    height: 16px;
  }

  /* Interest overlays */
  .interest-pop {
    position: absolute;
    z-index: 1200;
    min-width: 210px;
    max-width: 260px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(120, 190, 255, 0.28);
    background: rgba(8, 16, 28, 0.9);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.32);
    color: rgba(235, 245, 255, 0.9);
    backdrop-filter: blur(8px);
    transform: translate(-50%, -100%) scale(0.98);
    opacity: 0;
    transition: opacity 120ms ease, transform 120ms ease;
    pointer-events: auto;
  }

  .interest-pop.show {
    opacity: 1;
    transform: translate(-50%, -100%) scale(1);
  }

  .interest-pop-title {
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-bottom: 4px;
  }

  .interest-pop-body {
    font-size: 0.88rem;
    line-height: 1.35;
    margin: 0 0 6px;
  }

  .interest-pop-footer {
    font-size: 0.76rem;
    color: rgba(180, 210, 230, 0.78);
  }

  .interest-link {
    color: rgba(120, 200, 255, 0.95);
    text-decoration: none;
    border-bottom: 1px solid rgba(120, 200, 255, 0.35);
  }

  .interest-link:hover {
    color: rgba(255, 255, 255, 0.95);
    border-bottom-color: rgba(255, 255, 255, 0.6);
  }

  /* Overwatch burst */
  .ow-star {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 210, 120, 0.95), rgba(255, 140, 60, 0.1));
    box-shadow: 0 0 12px rgba(255, 210, 120, 0.65);
    pointer-events: none;
    animation: ow-burst 620ms ease-out forwards;
  }

  @keyframes ow-burst {
    to {
      transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.2);
      opacity: 0;
      filter: blur(1px);
    }
  }

  @media (max-width: 900px) {
    .hero-actions-grid {
      grid-template-columns: 1fr;
    }
    .hero-logos {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      justify-items: start;
    }
  }

  @media (max-width: 720px) {
    .hero-shell {
      flex-direction: column;
      align-items: stretch;
      height: auto;
    }

    .hero-layout {
      flex-direction: column;
      align-items: flex-start;
      height: auto;
    }

    .hero-content {
      width: 100%;
    }

    .hero-portrait {
      order: -1;
      width: 100%;
      justify-content: center;
      margin-bottom: 8px;
    }

    .hero-gallery {
      --gallery-height: clamp(180px, 62vw, 240px);
      --gallery-max-w: clamp(190px, 75vw, 300px);
      --gallery-min-w: 170px;
    }
  }
</style>
