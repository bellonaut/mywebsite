---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { LINKS } from "../lib/constants";

const email = LINKS.email;
const calLink = LINKS.calendar;
const emailSubject = encodeURIComponent("Hello Bashir");
---

<link
  rel="stylesheet"
  href="https://assets.calendly.com/assets/external/widget.css"
/>

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" title="Contact">
  <div class="contact">
    <p class="lead">
      Open to research collaboration, product work, and public-interest projects.
    </p>

    <div class="grid">
      <a class="btn" href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon class="ico" name="ri:linkedin-line" />
        <span>LinkedIn</span>
      </a>

      <a class="btn" href={LINKS.github} target="_blank" rel="noopener noreferrer">
        <Icon class="ico" name="ri:github-line" />
        <span>GitHub</span>
      </a>

      <a class="btn btn-strong" href={`mailto:${email}?subject=${emailSubject}`}>
        <Icon class="ico" name="ri:mail-line" />
        <span>Email</span>
      </a>

      <button class="btn btn-strong" type="button" data-calendly-url={calLink}>
        <Icon class="ico" name="ri:calendar-event-line" />
        <span>Book a call</span>
      </button>

      <a class="btn btn-substack" href={LINKS.substack} target="_blank" rel="noopener noreferrer">
        <Icon class="ico" name="ri:quill-pen-line" />
        <span>Substack</span>
      </a>
    </div>
  </div>
</Card>

<script is:inline>
  (function () {
    const CALENDLY_SRC = "https://assets.calendly.com/assets/external/widget.js";

    function loadCalendly() {
      return new Promise((resolve) => {
        if (window.Calendly) return resolve(window.Calendly);

        const existing = document.querySelector(
          'script[src="' + CALENDLY_SRC + '"]'
        );
        if (existing) {
          existing.addEventListener("load", () => resolve(window.Calendly));
          return;
        }

        const s = document.createElement("script");
        s.src = CALENDLY_SRC;
        s.async = true;
        s.onload = () => resolve(window.Calendly);
        document.head.appendChild(s);
      });
    }

    async function openCalendly(url) {
      const Calendly = await loadCalendly();
      if (!Calendly?.initPopupWidget) return;
      Calendly.initPopupWidget({ url });
    }

    document.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-calendly-url]");
      if (!btn) return;
      e.preventDefault();
      const link = btn.getAttribute("data-calendly-url");
      if (link) openCalendly(link);
    });
  })();
</script>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .lead {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.32;
    color: rgba(255, 255, 255, 0.76);
    letter-spacing: 0.01em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .btn-substack {
    grid-column: 1 / -1;
  }

  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .btn-substack {
      grid-column: auto;
    }
  }

  .btn {
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;

    width: 100%;
    padding: 0 1rem;
    border-radius: 12px;

    border: 1px solid rgba(175, 225, 255, 0.26);
    background: linear-gradient(
      120deg,
      rgba(56, 189, 248, 0.18),
      rgba(16, 196, 190, 0.12)
    );
    box-shadow:
      0 12px 26px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(6px);
    color: rgba(238, 247, 255, 0.95);
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.16);

    text-decoration: none;
    cursor: pointer;

    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: 0.01em;

    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease,
      filter 0.16s ease;
    user-select: none;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(120, 230, 255, 0.65);
    background: linear-gradient(
      120deg,
      rgba(86, 208, 255, 0.26),
      rgba(16, 196, 190, 0.18)
    );
    box-shadow:
      0 16px 30px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(120, 230, 255, 0.28),
      0 0 24px rgba(120, 230, 255, 0.16);
    outline: none;
  }

  .btn.btn-strong {
    border-color: rgba(120, 230, 255, 0.6);
    background: linear-gradient(
      130deg,
      rgba(86, 208, 255, 0.32),
      rgba(86, 208, 255, 0.18)
    );
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(120, 230, 255, 0.3),
      0 0 30px rgba(86, 208, 255, 0.18);
  }

  .btn.btn-strong:hover,
  .btn.btn-strong:focus-visible {
    border-color: rgba(120, 225, 255, 0.9);
    background: linear-gradient(
      130deg,
      rgba(120, 225, 255, 0.38),
      rgba(86, 208, 255, 0.24)
    );
    box-shadow:
      0 18px 36px rgba(0, 0, 0, 0.36),
      0 0 0 1px rgba(120, 225, 255, 0.55),
      0 0 36px rgba(120, 225, 255, 0.32);
  }

  .btn.btn-substack {
    border-color: rgba(210, 140, 255, 0.42);
    background: linear-gradient(125deg, rgba(252, 147, 255, 0.22), rgba(86, 208, 255, 0.16));
    box-shadow:
      0 14px 28px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(210, 140, 255, 0.28),
      0 0 30px rgba(180, 140, 255, 0.18);
  }

  .ico {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    color: currentColor;
    opacity: 0.96;
  }

  .btn span {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
