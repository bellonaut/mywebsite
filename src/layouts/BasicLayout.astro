---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Bashir Aminu Bello",
        url: Astro.url.origin,
        sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        image: `${Astro.url.origin}/og-image.png`,
        jobTitle: "Health Data Scientist",
        worksFor: {
          "@type": "Organization",
          name: "Independent Researcher",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Sokoto",
            addressCountry: "NG",
          },
        },
        nationality: {
          "@type": "Country",
          name: "Nigeria",
        },
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: title || title,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Bashir Aminu Bello",
          url: Astro.url.origin,
          sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        },
        publisher: {
          "@type": "Organization",
          name: "Bashir Aminu Bello",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={Astro.url.origin} property="og:url" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>

  <!-- ✅ Key fixes: remove md:h-screen and justify-center; use min-h and normal flow -->
<body class="bg-darkslate-700 text-neutral-50 min-h-[100dvh]">
  <div class="site-bg" aria-hidden="true"></div>
  <div id="comet-layer" aria-hidden="true"></div>

  <slot />
</body>

<style is:global>
  .site-bg{
    position: fixed;
    inset: 0;
    z-index: -50;
    pointer-events: none;

    background: linear-gradient(180deg, rgba(6, 14, 24, 0.95), rgba(6, 14, 24, 0.88));
    overflow: hidden;
  }

  #comet-layer {
    position: fixed;
    inset: 0;
    z-index: -51;
    pointer-events: none;
    overflow: hidden;
    mix-blend-mode: screen;
  }

  .comet {
    position: absolute;
    top: 0;
    left: 0;
    width: 18vw;
    height: 2px;
    background: linear-gradient(90deg, rgba(255,255,255,0), var(--comet-color, rgba(120,180,255,0.9)), rgba(255,255,255,0));
    filter: blur(1px);
    opacity: 0;
    transform: rotate(var(--angle, 8deg));
    animation: comet-run var(--duration, 2400ms) linear forwards;
  }

  @keyframes comet-run {
    0% { opacity: 0; transform: translate3d(-12vw, -6vh, 0) rotate(var(--angle, 8deg)); }
    8% { opacity: 1; }
    30% { opacity: 0.8; }
    60% { opacity: 0.2; }
    100% { transform: translate3d(115vw, 38vh, 0) rotate(var(--angle, 8deg)); opacity: 0; }
  }
</style>

<script is:inline>
  (() => {
    const reduce =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    const layer = document.getElementById("comet-layer");
    if (!layer) return;

    const colors = [
      "rgba(100,180,255,0.95)",
      "rgba(140,200,255,0.95)",
      "rgba(80,160,240,0.9)",
      "rgba(170,220,255,0.9)",
    ];

    const spawn = (depth = 0, opts = {}) => {
      const el = document.createElement("div");
      el.className = "comet";

      const top = opts.top ?? Math.random() * window.innerHeight * 0.8;
      const left = opts.left ?? -0.18 * window.innerWidth;
      const angle = opts.angle ?? (Math.random() * 10 + 4);
      const duration = opts.duration ?? 2200 + Math.random() * 600;
      const color = colors[Math.floor(Math.random() * colors.length)];

      el.style.top = `${top}px`;
      el.style.left = `${left}px`;
      el.style.setProperty("--angle", `${angle}deg`);
      el.style.setProperty("--duration", `${duration}ms`);
      el.style.setProperty("--comet-color", color);

      layer.appendChild(el);
      el.addEventListener("animationend", () => el.remove(), { once: true });

      // probabilistic split (max depth 2)
      if (depth < 2 && Math.random() < 0.55) {
        const branches = Math.random() < 0.6 ? 2 : 1;
        for (let i = 0; i < branches; i++) {
          const drift = (Math.random() - 0.5) * 140;
          setTimeout(() => {
            spawn(depth + 1, {
              top: top + drift,
              left: left + window.innerWidth * 0.25,
              angle: angle + (Math.random() - 0.5) * 14,
              duration: duration * (0.55 + Math.random() * 0.25),
            });
          }, 140 + Math.random() * 220);
        }
      }
    };

    const loop = () => {
      spawn();
      const jitter = Math.random() * 800 - 400; // +/- 0.4s
      setTimeout(loop, 4000 + jitter);
    };

    loop();
  })();
</script>

<style is:global>
  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden; /* ✅ prevent accidental horizontal scroll */
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }

  /* ✅ Make layout sizing predictable everywhere */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @keyframes ambient-drift {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-1.5%, 1%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bg-glow,
    .site-bg-twinkle,
    .site-bg-comet {
      animation: none !important;
      opacity: 0.3;
    }
  }
</style>
