---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  keywords?: readonly string[];
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
  robots?: string;
}

const { title, description, page, pubDate, keywords = [], robots = "index, follow" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const ogType = page === "blog" ? "article" : "website";
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const personSchema = {
  "@type": "Person",
  "@id": `${Astro.url.origin}/#person`,
  name: "Bashir Aminu Bello",
  url: Astro.url.origin,
  image: `${Astro.url.origin}/og-image.png`,
  sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
  jobTitle: "Healthcare Data Scientist",
  description:
    "Healthcare data scientist focused on public health AI, digital health tools, geospatial access modeling, policy analytics, and applied research partnerships.",
  knowsAbout: [
    "Public health analytics",
    "Healthcare AI",
    "Telehealth systems",
    "Health policy analysis",
    "Geospatial health modeling",
    "Health equity",
    "Health systems research",
    "Machine learning",
    "Data engineering",
    "Decision-support tools",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Independent Researcher",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Sokoto",
      addressCountry: "NG",
    },
  },
  nationality: {
    "@type": "Country",
    name: "Nigeria",
  },
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${Astro.url.origin}/#website`,
  url: Astro.url.origin,
  name: "Bashir Aminu Bello",
  description:
    "Portfolio and research site: healthcare AI projects, policy publications, Health Desert Scorer, and collaboration opportunities.",
  inLanguage: "en",
  publisher: { "@id": `${Astro.url.origin}/#person` },
};

const pageSchema = {
  "@type": page === "blog" ? "BlogPosting" : "WebPage",
  "@id": `${canonicalUrl}#page`,
  url: canonicalUrl,
  headline: title,
  name: title,
  description,
  image,
  inLanguage: "en",
  isPartOf: { "@id": `${Astro.url.origin}/#website` },
  about: { "@id": `${Astro.url.origin}/#person` },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  datePublished: pubDate || undefined,
  dateModified: pubDate || undefined,
  author: { "@id": `${Astro.url.origin}/#person` },
  publisher: { "@id": `${Astro.url.origin}/#person` },
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, pageSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    {keywords.length > 0 && <meta content={keywords.join(", ")} name="keywords" />}
    {keywords.length > 0 && <meta content={keywords.join(", ")} name="news_keywords" />}
    <meta content={robots} name="robots" />
    <meta content={robots} name="googlebot" />
    <meta content={robots} name="bingbot" />
    <meta content="Bashir Aminu Bello" name="author" />
    <meta content="Bashir Aminu Bello" name="creator" />
    <meta content="Bashir Aminu Bello" name="publisher" />
    <meta content="Healthcare Data Science" name="subject" />
    <meta content="NG" name="geo.region" />
    <meta content="Nigeria" name="geo.placename" />
    <meta content="#0a1225" name="theme-color" />
    <meta content="Bashir Aminu Bello" name="application-name" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={ogType} property="og:type" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content="Bashir Aminu Bello" property="og:site_name" />
    <meta content="en_NG" property="og:locale" />
    <meta content="en_US" property="og:locale:alternate" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />
    <meta
      content="Portfolio of healthcare AI projects, policy publications, and collaboration opportunities."
      property="og:image:alt"
    />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={canonicalUrl} rel="canonical" />
    <link href={canonicalUrl} rel="alternate" hrefLang="en" />
    <link href={canonicalUrl} rel="alternate" hrefLang="en-NG" />
    <link href={canonicalUrl} rel="alternate" hrefLang="x-default" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-pC-smWse2lyLTKcn4NHYR.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function () {
        (plausible.q = plausible.q || []).push(arguments);
      };
      plausible.init = plausible.init || function (i) {
        plausible.o = i || {};
      };
      plausible.init();
    </script>
  </head>

  <!-- ✅ Key fixes: remove md:h-screen and justify-center; use min-h and normal flow -->
<body class="bg-darkslate-700 text-neutral-50 min-h-[100dvh]">
  <div class="site-bg" aria-hidden="true"></div>

  <slot />

  <script is:inline>
    (() => {
      const endpoint = "/api/visit";
      const startedAt = Date.now();
      const startPerf = performance.now();
      const sessionId = crypto.randomUUID();
      const interactions = [];
      let sent = false;
      const notifyStorageKey = "bashir-visit-notify";

      const url = new URL(window.location.href);
      const notifyParam = url.searchParams.get("notify");
      if (notifyParam === "off") {
        localStorage.setItem(notifyStorageKey, "off");
      }
      if (notifyParam === "on") {
        localStorage.removeItem(notifyStorageKey);
      }

      const isSuppressed =
        localStorage.getItem(notifyStorageKey) === "off" ||
        ["localhost", "127.0.0.1"].includes(window.location.hostname);

      const recordInteraction = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const hit = target.closest("a, button, [role='button']");
        if (!hit) return;

        const label =
          hit.getAttribute("aria-label") ||
          hit.textContent?.trim().slice(0, 120) ||
          hit.tagName.toLowerCase();

        interactions.push({
          type: hit.tagName.toLowerCase(),
          label,
          href: hit instanceof HTMLAnchorElement ? hit.href : undefined,
          atMs: Math.round(performance.now() - startPerf),
        });

        if (interactions.length > 30) {
          interactions.shift();
        }
      };

      const sendSummary = () => {
        if (sent) return;
        if (isSuppressed) return;
        sent = true;

        const url = new URL(window.location.href);
        const payload = {
          sessionId,
          url: url.toString(),
          path: url.pathname,
          referrer: document.referrer || null,
          startedAt,
          durationMs: Math.round(performance.now() - startPerf),
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
          language: navigator.language,
          interactions,
          utm: Object.fromEntries(url.searchParams.entries()),
          suppressNotifications: isSuppressed,
        };

        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          navigator.sendBeacon(
            endpoint,
            new Blob([body], { type: "application/json" })
          );
          return;
        }

        fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      };

      document.addEventListener("click", recordInteraction, { capture: true });
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[data-event]");
        if (!(link instanceof HTMLAnchorElement)) return;
        const eventType = link.dataset.event;
        const eventMap = {
          "download-resume": "Download Resume",
          "book-call": "Book Call",
          "contact-email": "Email Click",
          "health-desert-page-open": "Health Desert Page Open",
          "health-desert-app-open": "Health Desert App Launch",
          "health-desert-whitepaper-open": "Health Desert Whitepaper Open",
          "health-desert-demo-open": "Health Desert Demo Open",
        };
        const eventName = eventType ? eventMap[eventType] : undefined;
        if (!eventName) return;
        window.plausible?.(eventName);
      });
      window.addEventListener("pagehide", sendSummary);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          sendSummary();
        }
      });
    })();
  </script>
</body>

<style is:global>
  .site-bg{
    position: fixed;
    inset: 0;
    z-index: -50;
    pointer-events: none;

    background:
      radial-gradient(1200px 880px at 15% 20%, rgba(64, 172, 255, 0.24), transparent 62%),
      radial-gradient(1050px 760px at 80% 18%, rgba(152, 124, 255, 0.22), transparent 64%),
      radial-gradient(1100px 820px at 62% 78%, rgba(16, 196, 190, 0.16), transparent 68%),
      radial-gradient(1000px 720px at 28% 82%, rgba(255, 120, 190, 0.13), transparent 70%),
      radial-gradient(1400px 1100px at 88% 88%, rgba(4, 6, 14, 0.55), transparent 58%),
      linear-gradient(185deg, #040914 0%, #0a1225 45%, #0b132a 100%);
    overflow: hidden;
  }

  /* static gradient background only */
</style>

<style is:global>
  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden; /* ✅ prevent accidental horizontal scroll */
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }

  /* ✅ Make layout sizing predictable everywhere */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

</style>


