---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Bashir Aminu Bello",
        url: Astro.url.origin,
        sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        image: `${Astro.url.origin}/og-image.png`,
        jobTitle: "Health Data Scientist",
        worksFor: {
          "@type": "Organization",
          name: "Independent Researcher",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Sokoto",
            addressCountry: "NG",
          },
        },
        nationality: {
          "@type": "Country",
          name: "Nigeria",
        },
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: title || title,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Bashir Aminu Bello",
          url: Astro.url.origin,
          sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        },
        publisher: {
          "@type": "Organization",
          name: "Bashir Aminu Bello",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={Astro.url.origin} property="og:url" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>

  <!-- ✅ Key fixes: remove md:h-screen and justify-center; use min-h and normal flow -->
<body class="bg-darkslate-700 text-neutral-50 min-h-[100dvh]">
  <div class="site-bg" aria-hidden="true"></div>
  <div class="site-bg-cells" aria-hidden="true"></div>
  <div class="site-bg-streaks" aria-hidden="true"></div>

  <slot />
</body>

<style is:global>
  .site-bg{
    position: fixed;
    inset: 0;
    z-index: -50;
    pointer-events: none;

    background:
      radial-gradient(1200px 900px at 20% 20%, rgba(56, 189, 248, 0.14), transparent 60%),
      radial-gradient(1000px 700px at 80% 10%, rgba(216, 30, 91, 0.12), transparent 65%),
      linear-gradient(180deg, rgba(6, 14, 24, 0.95), rgba(6, 14, 24, 0.88));

    /* Global starfield */
    overflow: hidden;
  }

  .site-bg::before,
  .site-bg::after {
    content: "";
    position: fixed;
    inset: -5%;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18% 24%, rgba(230, 255, 255, 0.9) 1.8px, transparent 4px),
      radial-gradient(circle at 62% 48%, rgba(200, 240, 255, 0.8) 1.6px, transparent 4px),
      radial-gradient(circle at 40% 80%, rgba(210, 240, 255, 0.78) 1.5px, transparent 4px),
      radial-gradient(circle at 74% 20%, rgba(200, 235, 255, 0.78) 1.6px, transparent 4px);
    mix-blend-mode: screen;
    opacity: 0.85;
    filter: blur(0.2px);
    animation: sky-drift-a 22s linear infinite;
    transform-origin: center;
  }

  .site-bg::after {
    opacity: 0.65;
    filter: blur(0.3px);
    animation: sky-drift-b 28s linear infinite;
  }

  .site-bg-cells {
    position: fixed;
    inset: -8%;
    z-index: -51;
    pointer-events: none;
    mix-blend-mode: screen;
    background-image:
      radial-gradient(circle, rgba(120, 200, 255, 0.6) 0%, transparent 42%),
      radial-gradient(circle, rgba(216, 80, 140, 0.45) 0%, transparent 44%),
      radial-gradient(circle, rgba(120, 255, 210, 0.45) 0%, transparent 40%),
      radial-gradient(circle, rgba(255, 210, 120, 0.38) 0%, transparent 38%);
    background-size: 480px 480px, 420px 420px, 360px 360px, 320px 320px;
    background-position: 20% 32%, 78% 18%, 42% 78%, 66% 26%;
    animation: cells-drift 14s ease-in-out infinite alternate;
    filter: blur(0.1px);
  }

  .site-bg-streaks {
    position: fixed;
    inset: -4%;
    z-index: -52;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      repeating-linear-gradient(
        25deg,
        rgba(120, 200, 255, 0.2) 0,
        rgba(120, 200, 255, 0.2) 120px,
        transparent 120px,
        transparent 280px
      ),
      repeating-linear-gradient(
        -18deg,
        rgba(216, 30, 91, 0.18) 0,
        rgba(216, 30, 91, 0.18) 140px,
        transparent 140px,
        transparent 300px
      );
    background-size: 1100px 1100px, 1200px 1200px;
    background-position: 0 0, 0 0;
    animation: streak-pan 12s linear infinite;
    opacity: 0.9;
    filter: blur(0.45px);
  }
</style>

<style is:global>
  @keyframes sky-drift-a {
    0% { transform: translate3d(-4%, -2%, 0) scale(1); }
    50% { transform: translate3d(4%, 2%, 0) scale(1.05); }
    100% { transform: translate3d(-4%, -2%, 0) scale(1); }
  }

  @keyframes sky-drift-b {
    0% { transform: translate3d(2%, 1%, 0) scale(1); }
    50% { transform: translate3d(-2.5%, -1.5%, 0) scale(1.04); }
    100% { transform: translate3d(2%, 1%, 0) scale(1); }
  }

  @keyframes cells-drift {
    0%   { background-position: 18% 28%, 80% 16%, 40% 76%, 64% 24%; background-size: 520px 520px, 460px 460px, 380px 380px, 340px 340px; }
    50%  { background-position: 28% 36%, 70% 24%, 48% 68%, 56% 32%; background-size: 580px 580px, 500px 500px, 360px 360px, 320px 320px; }
    100% { background-position: 22% 30%, 70% 18%, 42% 78%, 62% 26%; background-size: 540px 540px, 480px 480px, 380px 380px, 340px 340px; }
  }

  @keyframes streak-pan {
    0% { background-position: 0 0, 0 0; }
    100% { background-position: 1400px 900px, -1500px 950px; }
  }
</style>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden; /* ✅ prevent accidental horizontal scroll */
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }

  /* ✅ Make layout sizing predictable everywhere */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @keyframes ambient-drift {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-1.5%, 1%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-ambient {
      animation: none;
    }
  }
</style>
