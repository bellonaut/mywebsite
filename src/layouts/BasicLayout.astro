---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Bashir Aminu Bello",
        url: Astro.url.origin,
        sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        image: `${Astro.url.origin}/og-image.png`,
        jobTitle: "Health Data Scientist",
        worksFor: {
          "@type": "Organization",
          name: "Independent Researcher",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Sokoto",
            addressCountry: "NG",
          },
        },
        nationality: {
          "@type": "Country",
          name: "Nigeria",
        },
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: title || title,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Bashir Aminu Bello",
          url: Astro.url.origin,
          sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        },
        publisher: {
          "@type": "Organization",
          name: "Bashir Aminu Bello",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={Astro.url.origin} property="og:url" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>

  <!-- ✅ Key fixes: remove md:h-screen and justify-center; use min-h and normal flow -->
<body class="bg-darkslate-700 text-neutral-50 min-h-[100dvh]">
  <div class="site-bg" aria-hidden="true"></div>
  <div class="site-bg-glow" aria-hidden="true"></div>
  <div class="site-bg-twinkle" aria-hidden="true"></div>
  <div class="site-bg-comet" aria-hidden="true"></div>

  <slot />
</body>

<style is:global>
  .site-bg{
    position: fixed;
    inset: 0;
    z-index: -50;
    pointer-events: none;

    background:
      radial-gradient(1200px 900px at 20% 20%, rgba(56, 189, 248, 0.14), transparent 60%),
      radial-gradient(1000px 700px at 80% 10%, rgba(216, 30, 91, 0.12), transparent 65%),
      linear-gradient(180deg, rgba(6, 14, 24, 0.95), rgba(6, 14, 24, 0.88));

    overflow: hidden;
  }

  /* Soft glow layer */
  .site-bg-glow {
    position: fixed;
    inset: -6%;
    z-index: -51;
    pointer-events: none;
    background:
      radial-gradient(900px 600px at 22% 24%, rgba(80, 180, 255, 0.16), transparent 65%),
      radial-gradient(900px 600px at 78% 14%, rgba(216, 50, 110, 0.12), transparent 62%),
      radial-gradient(720px 520px at 50% 72%, rgba(90, 200, 180, 0.10), transparent 60%);
    animation: glow-drift 24s ease-in-out infinite alternate;
    filter: blur(0.2px);
  }

  /* Sparse twinkles */
  .site-bg-twinkle {
    position: fixed;
    width: 2px;
    height: 2px;
    inset: 0;
    z-index: -52;
    pointer-events: none;
    background: rgba(230, 245, 255, 0.9);
    box-shadow:
      12vw 8vh rgba(230,245,255,0.9),
      28vw 16vh rgba(200,230,255,0.75),
      42vw 32vh rgba(210,240,255,0.8),
      58vw 12vh rgba(220,250,255,0.82),
      72vw 28vh rgba(230,245,255,0.7),
      86vw 6vh rgba(200,235,255,0.85),
      18vw 54vh rgba(210,240,255,0.8),
      34vw 68vh rgba(230,245,255,0.75),
      62vw 74vh rgba(220,240,255,0.78),
      80vw 56vh rgba(230,245,255,0.8);
    animation: twinkle 4s steps(2, end) infinite;
  }

  /* Occasional comet */
  .site-bg-comet {
    position: fixed;
    top: -8vh;
    left: -18vw;
    width: 38vw;
    height: 2px;
    z-index: -53;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(190, 230, 255, 0.65), rgba(255,255,255,0));
    filter: blur(1px);
    opacity: 0;
    animation: comet 18s linear infinite;
  }
</style>

<style is:global>
  @keyframes glow-drift {
    0% { transform: translate3d(-2%, -1%, 0) scale(1); }
    50% { transform: translate3d(2%, 1.5%, 0) scale(1.02); }
    100% { transform: translate3d(-1%, 0.5%, 0) scale(1); }
  }

  @keyframes twinkle {
    0%, 48% { opacity: 0.25; }
    50% { opacity: 0.9; }
    52%, 100% { opacity: 0.3; }
  }

  @keyframes comet {
    0% { opacity: 0; transform: translate3d(-10vw, -6vh, 0) rotate(8deg) scaleX(1); }
    8% { opacity: 0.9; }
    30% { opacity: 0; }
    100% { transform: translate3d(110vw, 40vh, 0) rotate(8deg) scaleX(1); opacity: 0; }
  }
</style>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden; /* ✅ prevent accidental horizontal scroll */
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }

  /* ✅ Make layout sizing predictable everywhere */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @keyframes ambient-drift {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-1.5%, 1%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bg-glow,
    .site-bg-twinkle,
    .site-bg-comet {
      animation: none !important;
      opacity: 0.3;
    }
  }
</style>
