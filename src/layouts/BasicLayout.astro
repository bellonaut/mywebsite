---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Bashir Aminu Bello",
        url: Astro.url.origin,
        sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        image: `${Astro.url.origin}/og-image.png`,
        jobTitle: "Health Data Scientist",
        worksFor: {
          "@type": "Organization",
          name: "Independent Researcher",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Sokoto",
            addressCountry: "NG",
          },
        },
        nationality: {
          "@type": "Country",
          name: "Nigeria",
        },
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: title || title,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Bashir Aminu Bello",
          url: Astro.url.origin,
          sameAs: [LINKS.linkedin, LINKS.github, LINKS.substack],
        },
        publisher: {
          "@type": "Organization",
          name: "Bashir Aminu Bello",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={Astro.url.origin} property="og:url" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>

  <!-- ✅ Key fixes: remove md:h-screen and justify-center; use min-h and normal flow -->
<body class="bg-darkslate-700 text-neutral-50 min-h-[100dvh]">
  <div class="site-bg" aria-hidden="true"></div>

  <slot />

  <script is:inline>
    (() => {
      const endpoint = "/api/visit";
      const startedAt = Date.now();
      const startPerf = performance.now();
      const sessionId = crypto.randomUUID();
      const interactions = [];
      let sent = false;
      const notifyStorageKey = "bashir-visit-notify";

      const url = new URL(window.location.href);
      const notifyParam = url.searchParams.get("notify");
      if (notifyParam === "off") {
        localStorage.setItem(notifyStorageKey, "off");
      }
      if (notifyParam === "on") {
        localStorage.removeItem(notifyStorageKey);
      }

      const isSuppressed =
        localStorage.getItem(notifyStorageKey) === "off" ||
        ["localhost", "127.0.0.1"].includes(window.location.hostname);

      const recordInteraction = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const hit = target.closest("a, button, [role='button']");
        if (!hit) return;

        const label =
          hit.getAttribute("aria-label") ||
          hit.textContent?.trim().slice(0, 120) ||
          hit.tagName.toLowerCase();

        interactions.push({
          type: hit.tagName.toLowerCase(),
          label,
          href: hit instanceof HTMLAnchorElement ? hit.href : undefined,
          atMs: Math.round(performance.now() - startPerf),
        });

        if (interactions.length > 30) {
          interactions.shift();
        }
      };

      const sendSummary = () => {
        if (sent) return;
        if (isSuppressed) return;
        sent = true;

        const url = new URL(window.location.href);
        const payload = {
          sessionId,
          url: url.toString(),
          path: url.pathname,
          referrer: document.referrer || null,
          startedAt,
          durationMs: Math.round(performance.now() - startPerf),
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
          language: navigator.language,
          interactions,
          utm: Object.fromEntries(url.searchParams.entries()),
          suppressNotifications: isSuppressed,
        };

        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          navigator.sendBeacon(
            endpoint,
            new Blob([body], { type: "application/json" })
          );
          return;
        }

        fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      };

      document.addEventListener("click", recordInteraction, { capture: true });
      window.addEventListener("pagehide", sendSummary);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          sendSummary();
        }
      });
    })();
  </script>
</body>

<style is:global>
  .site-bg{
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(1200px 900px at 20% 22%, rgba(90, 180, 255, 0.14), transparent 62%),
      radial-gradient(1100px 750px at 78% 12%, rgba(160, 140, 255, 0.12), transparent 65%),
      linear-gradient(180deg, #060c1a, #0a1020);
  }

  /* ensure content sits above the animated backdrop */
  body > *:not(.site-bg){
    position: relative;
    z-index: 1;
  }

  .site-bg::before,
  .site-bg::after{
    content: "";
    position: absolute;
    inset: -10%;
    pointer-events: none;
  }

  /* Star field + faint comet trails */
  .site-bg::before{
    background-image:
      radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.92), transparent 55%),
      radial-gradient(1px 1px at 34% 74%, rgba(255, 255, 255, 0.85), transparent 55%),
      radial-gradient(1px 1px at 58% 48%, rgba(255, 255, 255, 0.95), transparent 55%),
      radial-gradient(1px 1px at 82% 20%, rgba(255, 255, 255, 0.82), transparent 55%),
      radial-gradient(1px 1px at 74% 64%, rgba(255, 255, 255, 0.80), transparent 55%),
      radial-gradient(1px 1px at 18% 84%, rgba(255, 255, 255, 0.75), transparent 55%),
      radial-gradient(1px 1px at 44% 26%, rgba(255, 255, 255, 0.90), transparent 55%),
      radial-gradient(1px 1px at 90% 80%, rgba(255, 255, 255, 0.88), transparent 55%),
      radial-gradient(2px 2px at 36% 66%, rgba(210, 225, 255, 0.40), transparent 62%),
      radial-gradient(2px 2px at 70% 28%, rgba(200, 215, 255, 0.32), transparent 62%),
      radial-gradient(1px 40px at 22% 40%, rgba(215, 230, 255, 0.25), transparent 70%),
      radial-gradient(1px 38px at 78% 58%, rgba(190, 210, 255, 0.18), transparent 70%),
      radial-gradient(1px 34px at 48% 16%, rgba(200, 215, 255, 0.16), transparent 70%);
    background-size:
      520px 420px,
      540px 440px,
      680px 520px,
      600px 480px,
      620px 500px,
      600px 480px,
      560px 420px,
      620px 460px,
      1200px 920px,
      1180px 920px,
      820px 720px,
      960px 880px,
      880px 740px;
    background-repeat: repeat;
    opacity: 0.92;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.12));
    animation: star-drift 120s linear infinite, star-twinkle 14s ease-in-out infinite;
  }

  /* Milky Way glow + drifting tendrils */
  .site-bg::after{
    background:
      radial-gradient(1200px 900px at 16% 26%, rgba(90, 180, 255, 0.12), transparent 62%),
      radial-gradient(1100px 820px at 74% 20%, rgba(140, 120, 255, 0.10), transparent 70%),
      linear-gradient(125deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04) 32%, transparent 65%),
      linear-gradient(285deg, rgba(90, 140, 255, 0.14), rgba(80, 120, 200, 0.08) 28%, transparent 62%),
      linear-gradient(180deg, rgba(6, 12, 26, 0.65), rgba(10, 16, 32, 0.90));
    background-size: 160% 160%, 150% 150%, 220% 220%, 260% 260%, 100% 100%;
    background-position: 45% 48%, 60% 32%, 18% 64%, 72% 46%, 50% 50%;
    mix-blend-mode: screen;
    filter: blur(10px);
    opacity: 0.72;
    animation: nebula-flow 120s ease-in-out infinite;
  }
</style>

<style is:global>
  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden; /* ✅ prevent accidental horizontal scroll */
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }

  /* ✅ Make layout sizing predictable everywhere */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  @keyframes ambient-drift {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-1.5%, 1%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes star-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-2.5%, 1.8%, 0) scale(1.02);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes star-twinkle {
    0%,
    100% {
      opacity: 0.7;
      filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.18));
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.32));
    }
  }

  @keyframes nebula-flow {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(-5%, 3%, 0) rotate(1.8deg) scale(1.03);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(3deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bg,
    .site-bg::before,
    .site-bg::after {
      animation: none !important;
    }
  }
</style>
