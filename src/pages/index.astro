---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";

import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import Globe from "../components/Globe";

import PostRow from "../components/Blog/PostRow.astro";
import MyStack from "../components/MyStack.astro";
import RecruiterCTA from "../components/RecruiterCTA.astro";
import { seo } from "../data/seo";

import { LINKS } from "../lib/constants";
import { fetchSubstackPosts } from "../lib/substack";

const substackPosts = await fetchSubstackPosts(LINKS.substack, 12).catch(() => []);
const homeSeo = seo.home;
---

<script>
  import type { AnimationSequence } from "motion";

  const runEntrance = async () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = document.querySelectorAll(".card");
    if (!cards.length) return;

    const { animate, stagger } = await import("motion");

    const sequence: AnimationSequence = [
      [
        ".loader",
        { opacity: [1, 0], pointerEvents: "none" },
        { ease: "easeOut" },
      ],
      [
        cards,
        { y: ["80%", "0%"], opacity: [0, 1] },
        {
          type: "spring",
          at: "-0.1",
          delay: stagger(0.12),
        },
      ],
    ];

    animate(sequence);
  };

  const scheduleEntrance = () => {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(runEntrance, { timeout: 1200 });
    } else {
      setTimeout(runEntrance, 150);
    }
  };

  if (document.readyState === "complete" || document.readyState === "interactive") {
    requestAnimationFrame(scheduleEntrance);
  } else {
    window.addEventListener("DOMContentLoaded", scheduleEntrance, { once: true });
  }
</script>

<Layout
  description={homeSeo.description}
  title={homeSeo.title}
  keywords={homeSeo.keywords}
>
  <main
    class="home-grid text-white mx-auto w-full relative grid gap-2.5 p-3
      sm:p-4 sm:gap-3
      md:grid-cols-2 md:gap-4 md:p-5
      lg:h-[calc(100dvh-1rem)] lg:grid-cols-4 lg:grid-rows-8 lg:gap-5
      max-w-[1500px] 2xl:max-w-[1600px]"
  >
    <!-- HERO -->
    <div class="g-hero">
      <IntroCard />
    </div>

    <!-- CONTACT -->
    <div class="g-contact">
      <ContactsCard />
    </div>

    <!-- TIMEZONES -->
    <div class="g-time">
      <TimeZone />
    </div>

    <!-- COUNTRIES -->
    <div class="g-travel">
      <Card
        colorText="text-white-900"
        href="travel"
        title="Where I've been"
        height="h-full"
      >
        <div class="globe-bg" aria-hidden="true">
          <Globe client:load variant="widget" />
        </div>
        <div class="h-full w-full" />
      </Card>
    </div>

    <!-- ✅ PROJECTS (surfaced before writing, esp. on mobile) -->
    <div class="g-projects">
      <Card title="Projects" height="h-full">
        <a
          class="card-open"
          href="/projects"
          aria-label="Open projects page"
          title="Open projects page"
        >
          <span class="card-open-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" role="presentation">
              <path
                d="M6 6h8v8M6 14l8-8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
        <div class="projects-visual" aria-hidden="true">
          <div class="pv-shell">
            <div class="pv-pill" style="--delay: 0s"></div>
            <span class="pv-caption">Health data / Telehealth / Policy / ML builds</span>
            <div class="pv-pill" style="--delay: 0.25s"></div>
          </div>
        </div>
        <div class="card-body">
          <div class="card-scroll">
            <MyStack />
          </div>
        </div>
      </Card>
    </div>

    <!-- ✅ LATEST ARTICLES (panel stays scrollable, follows projects on mobile) -->
    <!-- IMPORTANT: no href on Card (avoid anchor wrapper layout bug) -->
    <div class="g-writing">
      <Card title="Latest Articles" height="h-full">
        <a
          class="card-open"
          href={LINKS.substack}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open Substack"
          title="Open Substack"
        >
          <span class="card-open-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" role="presentation">
              <path
                d="M6 6h8v8M6 14l8-8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>

        <div class="card-body">
          <div class="card-scroll">
            <PostRow posts={substackPosts} limit={12} />
          </div>
        </div>
      </Card>
    </div>
  </main>

  <RecruiterCTA />

  <div class="maker-egg" title="Made by Bashir Aminu Bello (Sonic mode)">
    <button class="footer-pill-button" type="button" data-sonic-trigger aria-label="Play Sonic easter egg">
      <img
        src="/sonic/sonic.gif"
        alt=""
        width="18"
        height="18"
        loading="lazy"
        decoding="async"
      />
    </button>
    <small>Made by Bashir</small>
  </div>

  <style is:global>

    /* =============================
       GRID: keep symmetry
       ============================= */
    .home-grid > * {
      min-width: 0;
      min-height: 0;
    }

    .g-hero,
    .g-contact,
    .g-time,
    .g-travel,
    .g-writing,
    .g-projects {
      height: 100%;
      min-height: 0;
    }

    /* =============================
       LG placement
       ============================= */
    @media (min-width: 1024px) {
      .g-hero {
        grid-column: 1 / span 3;
        grid-row: 1 / span 3;
      }

      .g-contact {
        grid-column: 4 / span 1;
        grid-row: 1 / span 3;
      }

      .g-time {
        grid-column: 1 / span 1;
        grid-row: 4 / span 2;
      }

      .g-travel {
        grid-column: 1 / span 1;
        grid-row: 6 / span 3;
      }

      .g-writing {
        grid-column: 4 / span 1;
        grid-row: 4 / span 5;
      }

      .g-projects {
        grid-column: 2 / span 2;
        grid-row: 4 / span 5;
      }
    }

    /* =============================
       Countries globe background
       ============================= */
    .g-travel .card {
      position: relative;
      overflow: hidden;
      min-height: clamp(360px, 54vh, 600px);
    }

    .globe-bg {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      opacity: 1;
      background: radial-gradient(120% 120% at 20% 20%, rgba(86, 204, 255, 0.12), transparent),
        radial-gradient(120% 120% at 80% 80%, rgba(180, 106, 255, 0.12), transparent);
    }

    .globe-bg::before {
      content: "";
      position: absolute;
      inset: 10%;
      border-radius: 999px;
      background:
        radial-gradient(circle at 35% 35%, rgba(86, 204, 255, 0.22), transparent 55%),
        radial-gradient(circle at 70% 70%, rgba(180, 106, 255, 0.18), transparent 60%),
        radial-gradient(circle at 50% 50%, rgba(12, 24, 40, 0.8), rgba(10, 18, 32, 0.3));
      opacity: 0.9;
      filter: drop-shadow(0 18px 32px rgba(0, 0, 0, 0.36));
      z-index: 0;
    }

    .globe-bg > div {
      min-height: clamp(320px, 45vh, 520px);
      position: relative;
      z-index: 1;
    }

    .globe-bg canvas,
    .globe-bg svg,
    .globe-bg > * {
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    /* =============================
       Card inner scroll
       ============================= */
    .card-body {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 0;
      margin-top: 0.25rem;
    }

    :global(.card-content-scroll) {
      overflow: hidden;
    }
    .card-scroll::-webkit-scrollbar-thumb {
      background: rgba(175, 200, 214, 0.22);
      border-radius: 999px;
    }

    /* Projects mini-visual (stacked shimmer chips) */
    .projects-visual {
      position: relative;
      margin-top: 4px;
      margin-bottom: 4px;
      padding: 0 6px;
      display: flex;
      justify-content: center;
    }

    .pv-shell {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 999px;
      width: 100%;
      max-width: 100%;
      background: rgba(12, 24, 40, 0.55);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 0 18px rgba(120, 200, 255, 0.14);
      overflow: hidden;
    }

    .pv-pill {
      position: relative;
      height: 8px;
      width: 100%;
      border-radius: 999px;
      background: rgba(140, 200, 255, 0.12);
      overflow: hidden;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 0 12px rgba(120, 200, 255, 0.14);
    }

    .pv-pill::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(120, 200, 255, 0.0),
        rgba(200, 240, 255, 0.55),
        rgba(120, 200, 255, 0.0)
      );
      transform: translateX(-80%);
      animation: pvShimmer 3.4s ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }

    .pv-caption {
      font-size: 0.78rem;
      color: rgba(220, 240, 255, 0.85);
      letter-spacing: 0.01em;
      white-space: nowrap;
      text-align: center;
      font-family: "Satoshi", "Inter", system-ui, -apple-system, sans-serif;
      font-weight: 500;
    }

    @keyframes pvShimmer {
      0% { transform: translateX(-90%); opacity: 0; }
      12% { opacity: 1; }
      55% { transform: translateX(110%); opacity: 1; }
      100% { transform: translateX(110%); opacity: 0; }
    }

    @media (max-width: 640px) {
      .pv-row { gap: 6px; }
      .pv-pill { width: clamp(70px, 28vw, 120px); }
      .pv-caption {
        font-size: 0.72rem;
        white-space: normal;
        line-height: 1.3;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pv-pill::after { animation: none; opacity: 0.45; transform: none; }
    }

    /* Top-right open icon for panels */
    .card-open {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 20;
      display: inline-flex;
      width: 30px;
      height: 30px;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(175, 225, 255, 0.32);
      background: rgba(255, 255, 255, 0.07);
      line-height: 1;
    }

    .card-open:hover {
      border-color: rgba(86, 208, 255, 0.75);
      box-shadow: 0 0 0 1px rgba(86, 208, 255, 0.45),
        0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .card-open-icon {
      display: inline-flex;
      width: 14px;
      height: 14px;
    }

    .card-open-icon svg {
      width: 100%;
      height: 100%;
    }

    .new-highlight {
      box-shadow:
        0 0 0 1px rgba(120, 200, 255, 0.42),
        0 0 16px rgba(120, 200, 255, 0.32),
        0 0 38px rgba(80, 140, 255, 0.2);
      animation: latestGlow 1.4s ease-out 2;
    }

    @keyframes latestGlow {
      0% {
        box-shadow:
          0 0 0 0 rgba(120, 200, 255, 0.48),
          0 0 18px rgba(120, 200, 255, 0.42),
          0 0 40px rgba(80, 140, 255, 0.25);
      }
      100% {
        box-shadow:
          0 0 0 0 rgba(120, 200, 255, 0.08),
          0 0 6px rgba(120, 200, 255, 0.12),
          0 0 14px rgba(80, 140, 255, 0.06);
      }
    }

    /* Retired footer pill */
    .footer-pill-wrap { display: none; }

    /* Easter egg maker pill */
    .maker-egg {
      position: fixed;
      left: 14px;
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      z-index: 35;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.32rem 0.65rem;
      border-radius: 999px;
      border: 1px solid rgba(175, 200, 214, 0.16);
      background: rgba(10, 18, 30, 0.6);
      color: rgba(235, 245, 255, 0.82);
      font-size: 0.78rem;
      letter-spacing: 0.01em;
      opacity: 0.25;
      transition: opacity 160ms ease, transform 160ms ease;
      box-shadow:
        0 10px 20px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .maker-egg:hover,
    .maker-egg:focus-within {
      opacity: 1;
      transform: translateY(-1px);
    }

    .maker-egg img {
      display: block;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      filter: hue-rotate(120deg) saturate(1.3);
    }

    .maker-egg small {
      opacity: 0.92;
      font-weight: 700;
    }

    @media (max-width: 768px) {
      .maker-egg {
        display: none;
      }
    }
  </style>

  <script is:inline>
    // First-visit highlight for Projects to steer focus there
    (() => {
      const projectsCard = document.querySelector(".g-projects .card");
      if (!projectsCard) return;
      if (sessionStorage.getItem("projects-highlighted")) return;

      projectsCard.classList.add("new-highlight");
      sessionStorage.setItem("projects-highlighted", "1");
      setTimeout(() => projectsCard.classList.remove("new-highlight"), 2600);
    })();

    (() => {
      const triggers = Array.from(document.querySelectorAll("[data-sonic-trigger]"));
      const audio = document.querySelector("[data-sonic-audio]");
      if (!triggers.length || !audio) return;

      const warmAudio = () => {
        try {
          audio.load();
        } catch (err) {
          console.debug("Sonic audio could not warm:", err);
        }
      };

      if ("requestIdleCallback" in window) {
        requestIdleCallback(warmAudio, { timeout: 800 });
      } else {
        setTimeout(warmAudio, 400);
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener("pointerenter", warmAudio, { once: true, passive: true });
        trigger.addEventListener("click", async () => {
          try {
            audio.currentTime = 0;
            await audio.play();
          } catch (err) {
            console.warn("Sonic audio could not play:", err);
          }
        });
      });
    })();
  </script>
</Layout>
