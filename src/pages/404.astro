---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found — Bashir Aminu Bello"
  description="The page you requested could not be found."
>
  <main class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-6 text-center text-white">
    <p class="text-7xl font-bold text-blue-300">404</p>
    <h1 class="mt-2 text-3xl font-semibold">Page Not Found</h1>
    <p class="mt-3 text-white/80">The page you requested may have moved. Try one of these links.</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="rounded-lg bg-blue-600 px-4 py-2 font-semibold" href="/">Back home</a>
      <a class="rounded-lg border border-white/30 px-4 py-2 font-semibold" href="/projects">View projects</a>
      <a class="rounded-lg border border-white/30 px-4 py-2 font-semibold" href="mailto:bashiraminubellok@gmail.com">Contact</a>
    </div>
  </main>
</Layout>
