---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe";
---

<Layout title="Travel" description=" ">
  <main class="travel-wrap">
    <a class="back-link travel-back" href="/" aria-label="Back home">
      <span class="back-dot" aria-hidden="true"></span>
      <span class="back-text">Back home</span>
      <span class="back-arrow" aria-hidden="true">↩</span>
    </a>

    <div class="travel-stage">
      <Globe client:load variant="full" />
    </div>
  </main>
</Layout>

<style>
  .travel-wrap {
    position: relative;
    min-height: 100dvh;
    padding: 1rem;
  }

  .travel-stage {
    position: relative;
    height: calc(100dvh - 3rem);
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(175, 200, 214, 0.12);
    background: rgba(255, 255, 255, 0.02);
  }

  .back-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: rgba(235, 245, 255, 0.95);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    border: 1px solid rgba(175, 200, 214, 0.18);
    background: rgba(15, 25, 35, 0.55);
    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
  }

  .back-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(120, 225, 255, 0.95);
    box-shadow: 0 0 0 0 rgba(120, 225, 255, 0.45);
    animation: pulse 1.8s ease infinite;
  }

  .back-arrow {
    font-weight: 700;
    opacity: 0.92;
  }

  .back-link:hover {
    border-color: rgba(120, 225, 255, 0.6);
    box-shadow: 0 10px 24px rgba(80, 140, 255, 0.28);
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(120, 225, 255, 0.45); }
    70% { box-shadow: 0 0 0 9px rgba(120, 225, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(120, 225, 255, 0); }
  }
</style>
