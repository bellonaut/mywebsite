---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe";
---

<Layout title="Travel" description=" ">
  <main class="travel-wrap">
    <a class="back-link travel-back" href="/" aria-label="Back home">
      &larr; Back home
    </a>

    <div class="travel-stage">
      <Globe client:load variant="full" />
    </div>
  </main>
</Layout>

<style>
  .travel-wrap {
    position: relative;
    min-height: 100dvh;
    padding: 1rem;
  }

  .travel-stage {
    position: relative;
    height: calc(100dvh - 3rem);
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(175, 200, 214, 0.12);
    background: rgba(255, 255, 255, 0.02);
  }

  .back-link {
    position: fixed;
    top: 14px;
    left: 14px;
    z-index: 10;
    color: rgba(160, 210, 255, 0.95);
    text-decoration: none;
    font-size: 0.9rem;
    width: fit-content;
    padding: 0.45rem 0.7rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(175, 200, 214, 0.25);
    backdrop-filter: blur(10px);
  }

  .back-link:hover {
    color: rgba(255, 255, 255, 0.95);
    border-color: rgba(56, 189, 248, 0.45);
  }
</style>
