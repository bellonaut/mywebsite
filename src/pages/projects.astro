---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import MyStack from "../components/MyStack.astro";
import SiteLinkHub from "../components/SiteLinkHub.astro";
import { LINKS } from "../lib/constants";
import { seo } from "../data/seo";

const pageSeo = seo.projects;
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageSeo.keywords}
>
  <main class="projects-page">
    <header class="projects-header">
      <a class="back-link" href="/">Back home</a>
      <SiteLinkHub current="projects" />
      <h1>Projects</h1>
      <p>
        Full project narratives, methods, and next steps. For the featured deployment,
        start on <a href={LINKS.healthDesertPage} data-event="health-desert-page-open">Health Desert</a>.
        For report outputs, go to <a href="/publications">Publications</a>, or
        <a href={LINKS.healthDesertDemo} target="_blank" rel="noopener noreferrer" data-event="health-desert-demo-open">watch the live demo</a>.
      </p>
    </header>

    <Card title="All Projects" height="h-full">
      <div class="card-body">
        <div class="card-scroll">
          <MyStack />
        </div>
      </div>
    </Card>
  </main>
</Layout>

<style is:global>
  .projects-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: rgba(235, 245, 255, 0.92);
  }

  .projects-header h1 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.6rem);
  }

  .projects-header p {
    margin: 0;
    max-width: 700px;
    color: rgba(220, 235, 255, 0.7);
  }

  .projects-header p a {
    color: rgba(184, 223, 255, 0.95);
  }

  .back-link {
    color: rgba(160, 210, 255, 0.95);
    text-decoration: none;
    font-size: 0.9rem;
    width: fit-content;
  }

  .back-link:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    margin-top: 0.25rem;
  }

  .card-scroll {
    flex: 1;
    min-height: 0;
    overflow: visible;
  }
</style>
