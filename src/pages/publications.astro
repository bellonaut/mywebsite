---
import Layout from "../layouts/Layout.astro";
import PublicationsList from "../components/PublicationsList.astro";
import { publications } from "../data/publications";
import { LINKS } from "../lib/constants";
---

<Layout
  title="Publications - Bashir Aminu Bello"
  description="Peer-reviewed and policy publications by Bashir Aminu Bello."
>
  <main class="page">
    <header class="hero">
      <a class="back" href="/">Back home</a>
      <div>
        <p class="eyebrow">Research & policy</p>
        <h1>Publications</h1>
        <p class="lead">
          Formal manuscripts and policy pieces. Technical builds stay in
          <a href="/projects">Projects</a>; Substack essays stay in
          <a href={LINKS.substack} target="_blank" rel="noopener noreferrer">Articles</a>.
        </p>
      </div>
    </header>

    <PublicationsList items={publications} />
  </main>
</Layout>

<style is:global>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: rgba(235, 245, 255, 0.92);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .back {
    color: rgba(160, 210, 255, 0.95);
    text-decoration: none;
    font-size: 0.9rem;
    width: fit-content;
  }

  .back:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  .eyebrow {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(180, 215, 255, 0.72);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.6rem);
  }

  .lead {
    margin: 0;
    max-width: 760px;
    color: rgba(210, 230, 255, 0.78);
  }

  .lead a {
    color: rgba(184, 223, 255, 0.95);
  }
</style>
