---
import Layout from "../layouts/Layout.astro";
import SiteLinkHub from "../components/SiteLinkHub.astro";
import { LINKS } from "../lib/constants";
import { seo } from "../data/seo";

const pageSeo = seo.healthDesert;
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageSeo.keywords}
>
  <main class="health-page">
    <header class="hero">
      <a class="back-link" href="/">Back home</a>
      <SiteLinkHub current="health-desert" />

      <div class="hero-copy">
        <p class="eyebrow">Nigeria health-access planning</p>
        <h1>Health Desert Scorer</h1>
        <p class="lead">
          Web-based decision support to identify LGAs with higher practical barriers to care,
          then prioritize outreach with transparent, map-first evidence.
        </p>
      </div>

      <div class="actions">
        <a
          class="btn btn-primary"
          href={LINKS.healthDesertApp}
          target="_blank"
          rel="noopener noreferrer"
          data-event="health-desert-app-open"
          data-health-app-link
        >
          Open Live App
        </a>
        <a
          class="btn btn-ghost"
          href={LINKS.healthDesertDemo}
          target="_blank"
          rel="noopener noreferrer"
          data-event="health-desert-demo-open"
        >
          Watch Live Demo
        </a>
        <a
          class="btn btn-ghost"
          href={LINKS.healthDesertWhitepaper}
          target="_blank"
          rel="noopener noreferrer"
          data-event="health-desert-whitepaper-open"
        >
          Read White Paper
        </a>
      </div>
    </header>

    <section class="panel">
      <h2>Quick start</h2>
      <ol>
        <li>Open the app and select a state (or All Nigeria).</li>
        <li>Select a year and focus (all risk, child mortality, facility access, connectivity, 5km coverage).</li>
        <li>Review map layers and the highest-need LGA list.</li>
      </ol>
    </section>

    <section class="panel">
      <h2>Who this helps</h2>
      <ul>
        <li>Frontline health teams and NGO programs.</li>
        <li>Government policy units and implementation partners.</li>
        <li>Donors, researchers, and students working on geographic prioritization.</li>
      </ul>
    </section>

    <section class="panel">
      <h2>Responsible use</h2>
      <ul>
        <li>Planning support only, not diagnosis.</li>
        <li>Always pair with field validation and local context.</li>
        <li>Do not use as the sole basis for high-stakes decisions.</li>
      </ul>
    </section>

    <section class="panel">
      <h2>Related pages</h2>
      <p>
        Explore implementation detail in <a href="/projects">Projects</a>, read document outputs in
        <a href="/publications">Publications</a>, and see external writing in
        <a href={LINKS.substack} target="_blank" rel="noopener noreferrer">Articles</a>.
      </p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const url = new URL(window.location.href);
      const incoming = url.searchParams;
      const passThrough = new URLSearchParams();

      const allowedKeys = [
        "src",
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_term",
        "utm_content",
      ];
      for (const key of allowedKeys) {
        const value = incoming.get(key);
        if (value) passThrough.set(key, value);
      }

      if (!passThrough.has("utm_source")) passThrough.set("utm_source", "bashir_bio");
      if (!passThrough.has("utm_medium")) passThrough.set("utm_medium", "portfolio");
      if (!passThrough.has("utm_campaign")) passThrough.set("utm_campaign", "health_desert");

      const appLinks = document.querySelectorAll("a[data-health-app-link]");
      appLinks.forEach((el) => {
        if (!(el instanceof HTMLAnchorElement)) return;
        const target = new URL(el.href);
        passThrough.forEach((value, key) => {
          target.searchParams.set(key, value);
        });
        el.href = target.toString();
      });
    })();
  </script>
</Layout>

<style is:global>
  .health-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 1.5rem;
    display: grid;
    gap: 1rem;
    color: rgba(235, 245, 255, 0.93);
  }

  .hero {
    display: grid;
    gap: 0.75rem;
  }

  .back-link {
    width: fit-content;
    color: rgba(160, 210, 255, 0.95);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-copy {
    display: grid;
    gap: 0.35rem;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(185, 220, 255, 0.74);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.7rem);
  }

  .lead {
    margin: 0;
    max-width: 72ch;
    color: rgba(216, 234, 255, 0.82);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .btn {
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(175, 225, 255, 0.26);
    background: rgba(255, 255, 255, 0.07);
    color: rgba(236, 247, 255, 0.95);
    padding: 0 1rem;
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(140, 220, 255, 0.75);
    outline: none;
  }

  .btn-primary {
    border-color: rgba(120, 225, 255, 0.72);
    background: linear-gradient(
      125deg,
      rgba(86, 208, 255, 0.34),
      rgba(56, 189, 248, 0.24)
    );
    box-shadow:
      0 10px 24px rgba(10, 28, 46, 0.35),
      0 0 0 1px rgba(120, 225, 255, 0.28);
  }

  .panel {
    border-radius: 14px;
    border: 1px solid rgba(145, 210, 255, 0.2);
    background:
      linear-gradient(145deg, rgba(20, 45, 74, 0.4), rgba(8, 18, 32, 0.62));
    padding: 0.95rem 1rem;
  }

  .panel h2 {
    margin: 0 0 0.55rem;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .panel p,
  .panel li {
    margin: 0;
    color: rgba(228, 242, 255, 0.87);
    line-height: 1.5;
    font-size: 0.92rem;
  }

  .panel ul,
  .panel ol {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .panel a {
    color: rgba(186, 224, 255, 0.96);
  }
</style>
